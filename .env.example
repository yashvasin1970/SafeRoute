# Copy to .env to fix these values. If unset, SafeRoute generates random ones on first run and
# keeps them in instance/secrets.json (the server prints the responder passcode when it starts).
SAFEROUTE_RESPONDER_PASSCODE=
SAFEROUTE_SENSOR_KEY=
SAFEROUTE_SECRET_KEY=
# Optional: require this responder ID at sign-in (otherwise any name or unit is accepted).
SAFEROUTE_RESPONDER_ID=
