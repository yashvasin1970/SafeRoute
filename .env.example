# Copy to .env to fix these values. If unset, SafeRoute generates random ones on first run and
# keeps them in instance/secrets.json. Responders sign in with a name alone — there is no passcode.
SAFEROUTE_SENSOR_KEY=
SAFEROUTE_SECRET_KEY=
# Optional: limit sign-in to this one name or unit (otherwise any name or unit is accepted).
SAFEROUTE_RESPONDER_ID=
